# Jarves configuration
JARVES_HOST=127.0.0.1
JARVES_PORT=8765
JARVES_LOG_LEVEL=INFO

# LLM (Phase 3)
# Get a key at https://console.anthropic.com/. Without this, Jarves only handles
# regex-matched commands; conversational queries will return a stub reply.
ANTHROPIC_API_KEY=
JARVES_MODEL=claude-sonnet-4-6
JARVES_HARD_MODEL=claude-opus-4-7
JARVES_MAX_TOKENS=1024
JARVES_SYSTEM_PROMPT_PATH=prompts/system.md

# Memory (Phase 4)
JARVES_DATA_DIR=data
JARVES_DB_PATH=data/jarves.sqlite
JARVES_CHROMA_PATH=data/chroma
JARVES_MEMORY_TOP_K=5

# File operations (Phase 5) — JARVES_FILE_ROOT confines all file ops to this tree.
# Defaults to your home directory. Set JARVES_ALLOW_DESTRUCTIVE=true to skip the
# explicit confirm flag for delete (NOT recommended).
# JARVES_FILE_ROOT=C:\Users\you
# JARVES_ALLOW_DESTRUCTIVE=false

# Telegram (Phase 5+)
# 1. @BotFather da yangi bot yarating → TOKEN oling
# 2. Botga /start yuboring, so'ng https://api.telegram.org/bot<TOKEN>/getUpdates dan chat_id oling
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Drive
# 1. https://console.cloud.google.com/ → APIs & Services → Enable "Google Drive API"
# 2. Credentials → Create OAuth 2.0 Client ID (Desktop app) → download JSON
# 3. Save JSON to data/google_credentials.json
# 4. Run: .venv\Scripts\python.exe scripts\setup_google_drive.py
# (no .env vars needed — token stored in data/google_token.json)

# Canva
# 1. https://www.canva.com/developers/ → Create App → Connect API
# 2. Add redirect URI: http://localhost:8766/callback
# 3. Copy Client ID and Secret below, then run: .venv\Scripts\python.exe scripts\setup_canva.py
JARVES_CANVA_CLIENT_ID=
JARVES_CANVA_CLIENT_SECRET=

# Voice (used in Phase 2)
JARVES_WAKE_WORD=hey_jarves
JARVES_STT_BACKEND=faster-whisper
JARVES_TTS_BACKEND=piper
